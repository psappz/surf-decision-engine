# Copy to .env for local development. Do not commit real secrets.
APP_NAME=WaveWatch
APP_ENV=development
SECRET_KEY=change-me
SECURE_COOKIES=false
ENABLE_LIVE_FETCH=false
POSTGRES_DB=wavewatch
POSTGRES_USER=wavewatch
POSTGRES_PASSWORD=wavewatch_dev_password

COPERNICUSMARINE_ENABLED=false
COPERNICUSMARINE_PRODUCT_ID=GLOBAL_ANALYSISFORECAST_WAV_001_027
COPERNICUSMARINE_DATASET_ID=cmems_mod_glo_wav_anfc_0.083deg_PT3H-i
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=
COPERNICUSMARINE_CACHE_DIR=data/provider-cache/copernicus
COPERNICUSMARINE_VARIABLE_MAP_JSON={"wave_height":"VHM0","wave_direction":"VMDR","wave_period":"VTPK","swell_wave_height":"VHM0_SW1","swell_wave_direction":"VMDR_SW1","swell_wave_period":"VTM01_SW1","wind_wave_height":"VHM0_WW","wind_wave_direction":"VMDR_WW","wind_wave_period":"VTM01_WW"}
COPERNICUS_MIN_LONGITUDE=-9.15
COPERNICUS_MAX_LONGITUDE=-8.65
COPERNICUS_MIN_LATITUDE=36.95
COPERNICUS_MAX_LATITUDE=37.60
